#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -euo pipefail
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
demo_python="$repo_dir/sources/vision-venv/bin/python"
if [[ ! -x "$demo_python" ]]; then
  echo "Missing vision environment; see demo/vision.md." >&2
  exit 1
fi
if [[ $EUID -eq 0 || ${1:-} == --help || ${1:-} == -h ]]; then
  exec "$demo_python" "$repo_dir/demo/vision.py" classify "$@"
fi
exec pkexec --keep-cwd "$demo_python" "$repo_dir/demo/vision.py" classify "$@"
