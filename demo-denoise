#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -euo pipefail
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
demo_python="$repo_dir/venv/bin/python"
if [[ ! -x "$demo_python" ]]; then
  echo "Missing Python environment ($demo_python); see docs/setup.md." >&2
  exit 1
fi
exec "$demo_python" "$repo_dir/demo/vision.py" denoise "$@"
