post_install() {
  for kdir in /usr/lib/modules/*; do
    [[ -d "$kdir" ]] && depmod -a "${kdir##*/}"
  done
  printf '%s\n' 'ACPI modaliases load the driver. Install firmware and use translated DMA domains.'
}

post_upgrade() {
  post_install
}

post_remove() {
  for kdir in /usr/lib/modules/*; do
    [[ -d "$kdir" ]] && depmod -a "${kdir##*/}"
  done
}
