post_install() {
  for kdir in /usr/lib/modules/*; do
    [[ -d "$kdir" ]] && depmod -a "${kdir##*/}"
  done
  systemctl daemon-reload >/dev/null 2>&1 || true
  printf '%s\n' 'Enable n1x-npu.service after installing firmware in /usr/lib/firmware/nvidia/n1x/.'
}

post_upgrade() {
  post_install
}

post_remove() {
  for kdir in /usr/lib/modules/*; do
    [[ -d "$kdir" ]] && depmod -a "${kdir##*/}"
  done
  systemctl daemon-reload >/dev/null 2>&1 || true
}
