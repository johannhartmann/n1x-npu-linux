[Unit]
Description=NVIDIA N1X NPU Kernel Driver
Documentation=https://github.com/johannhartmann/n1x-npu-linux
After=systemd-modules-load.service
Before=multi-user.target
ConditionPathExists=/sys/bus/platform/devices/NVDA200A:00
ConditionPathExists=/sys/bus/platform/devices/NVDA8600:00

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sh -c 'for d in NVDA200A:00 NVDA8600:00; do t="/sys/bus/platform/devices/$d/iommu_group/type"; [ -e "/sys/bus/platform/devices/$d/driver" ] || [ "$(cat "$t")" != identity ] || echo DMA > "$t"; done'
ExecStart=/usr/bin/modprobe n1x_npu_bootstrap
ExecStop=/usr/bin/modprobe -r n1x_npu_bootstrap
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=no
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
