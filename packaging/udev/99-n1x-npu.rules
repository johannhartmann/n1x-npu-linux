# Switch isolated N1X NPU (NVDA200A) and SROOT (NVDA8600) IOMMU groups from
# passthrough (identity) to translated DMA before binding n1x_npu_bootstrap.
SUBSYSTEM=="platform", KERNEL=="NVDA200A:00|NVDA8600:00", ACTION=="add", ATTR{iommu_group/type}=="identity", ATTR{iommu_group/type}="DMA"

# Grant standard render-group and active desktop session (uaccess) access to /dev/accel/accel*.
SUBSYSTEM=="accel", KERNEL=="accel*", DRIVERS=="n1x-npu-bootstrap", GROUP="render", MODE="0660", TAG+="uaccess"
